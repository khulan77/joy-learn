{
  "name": "joy-learn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "dev:api": "bun run build:api && bun --env-file=.env dist/apps/api/src/main.js",
    "build:api": "tsc -p apps/api/tsconfig.json",
    "start:api": "node --env-file-if-exists=.env dist/apps/api/src/main.js",
    "typecheck": "next typegen && tsc --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "bun test tests/tutor.test.ts tests/storage-config.test.ts",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "test:e2e": "playwright test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema packages/database/prisma/schema.prisma",
    "db:status": "prisma migrate status --schema packages/database/prisma/schema.prisma",
    "test:postgres": "bun run build:api && bun test ./tests/postgres.integration.ts",
    "db:native:install": "npm install --cache .data/npm-cache --prefix .data/postgres-runtime embedded-postgres@17.10.0-beta.17",
    "db:native": "node --env-file=.env scripts/dev-postgres.mjs"
  },
  "dependencies": {
    "@nestjs/common": "11",
    "@nestjs/core": "11",
    "@nestjs/platform-express": "11",
    "@prisma/client": "6",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prisma": "6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.11",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
