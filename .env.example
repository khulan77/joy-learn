# Copy to .env and replace the password in BOTH places; never commit .env.
STORAGE_MODE=postgres
POSTGRES_USER=joy
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=joy_learn
POSTGRES_PORT=5432
# URL-encode special characters in the password; keep this aligned with values above.
DATABASE_URL=postgresql://joy:replace_with_a_local_password@127.0.0.1:5432/joy_learn?schema=public
API_PORT=3001
API_URL=http://127.0.0.1:3001
# Optional dedicated disposable database/schema for integration tests, never production:
# TEST_DATABASE_URL=postgresql://joy:replace_with_a_local_password@127.0.0.1:5432/joy_learn?schema=joy_test_local
# Set STORAGE_MODE=file explicitly to use local .data/sessions without PostgreSQL.
